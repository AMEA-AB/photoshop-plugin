{
    "compilerOptions": {
        "baseUrl": "./src",
        "outDir": "./dist/",
        "sourceMap": true,
        "noImplicitAny": false,
        "target": "es5",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "react",
        "typeRoots": [
            "node_modules/@types",
            "node_modules/uxp-types",
        ],
        "lib": [
            "esnext",
            "dom"
        ],
        "paths": {
          "@services/*": ["services/*"],
          "@helpers": ["helpers"],
          "@components/*": ["components/*"],
        }
    },
    "exclude": [
        "node_modules"
    ]
}
